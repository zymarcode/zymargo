{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/rpc",
      "destination": "/api/rpc"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/manifest"
    },
    {
      "source": "/sw.js",
      "destination": "/api/sw"
    },
    {
      "source": "/s/:p*",
      "destination": "/api/stream?p=:p*"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{views,lib}/**",
      "maxDuration": 300
    }
  }
}
